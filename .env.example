# ============================================
# API CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# MODEL CONFIGURATION
# ============================================
MODEL_PATH=models/artifact_model_rf.joblib
ICA_METHOD=fastica
N_COMPONENTS=20
DETECTION_THRESHOLD=0.7

# ============================================
# DATA PROCESSING
# ============================================
SAMPLING_RATE=250.0
BAND_PASS_LOW=1.0
BAND_PASS_HIGH=40.0
NOTCH_FILTER=50.0
WINDOW_SIZE=512
OVERLAP=0.5

# ============================================
# PERFORMANCE
# ============================================
MAX_BATCH_SIZE=1024
CACHE_SIZE=100
CACHE_TTL=3600
TIMEOUT_SECONDS=30

# ============================================
# SECURITY
# ============================================
ENCRYPTION_ENABLED=True
RATE_LIMIT=1000
RATE_LIMIT_WINDOW=60
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://bciuser:password@postgres:5432/bci
REDIS_URL=redis://redis:6379

# ============================================
# MONITORING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
